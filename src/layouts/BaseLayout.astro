---
import '../styles/global.css';
import { withBase } from '../lib/base-path';

const { title = 'MSP', description = 'Centralized documentation portal', repoUrl = 'https://github.com/Leonard-Data/msp' } = Astro.props;
const base = import.meta.env.BASE_URL;
const homeHref = withBase(base);
const docsHref = withBase(base, 'docs/');
const howItWorksHref = withBase(base, 'docs/how-it-works/');
const searchHref = withBase(base, 'search/');
const logoHref = withBase(base, 'assets/logo-mark.svg');
---
<!doctype html>
<html lang="en" data-base={base}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={withBase(base, 'assets/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&family=Source+Serif+4:wght@600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <div class="shell">
      <header class="topbar">
        <div class="topbar__inner">
          <a class="brand" href={homeHref}>
            <img src={logoHref} alt="MSP" />
            <span>MSP Docs</span>
          </a>
          <nav class="topnav" aria-label="Primary">
            <a href={docsHref}>Documentation</a>
            <a href={howItWorksHref}>How it works</a>
            <a href={searchHref}>Search</a>
          </nav>
          <div class="topbar__actions">
            <a class="search-trigger" href={searchHref}>Search</a>
            <a href={repoUrl} target="_blank" rel="noreferrer">GitHub</a>
            <a class="button button--primary" href={`${repoUrl}/issues/new/choose`} target="_blank" rel="noreferrer">Add documentation</a>
          </div>
        </div>
      </header>
      <slot />
    </div>
  </body>
</html>
