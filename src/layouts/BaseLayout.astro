---
import '../styles/global.css';

const { title = 'MSP', description = 'Centralized documentation portal', repoUrl = 'https://github.com/Leonard-Data/msp' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en" data-base={base}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}assets/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&family=Source+Serif+4:wght@600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <div class="shell">
      <header class="topbar">
        <div class="topbar__inner">
          <a class="brand" href={base}/>
            <img src={`${base}/assets/logo-mark.svg`} alt="MSP" />
            <span>MSP Docs</span>
          </a>
          <nav class="topnav" aria-label="Primary">
            <a href={`${base}/docs/`}>Documentation</a>
            <a href={`${base}/docs/how-it-works/`}>How it works</a>
            <a href={`${base}/search/`}>Search</a>
          </nav>
          <div class="topbar__actions">
            <a class="search-trigger" href={`${base}search/`}>Search</a>
            <a href={repoUrl} target="_blank" rel="noreferrer">GitHub</a>
            <a class="button button--primary" href={`${repoUrl}/issues/new/choose`} target="_blank" rel="noreferrer">Add documentation</a>
          </div>
        </div>
      </header>
      <slot />
    </div>
  </body>
</html>
