---
// @ts-nocheck
import { marked } from 'marked';
import { withBase } from '../lib/base-path';

const { page } = Astro.props;
const base = import.meta.env.BASE_URL;
const renderer = new marked.Renderer();

renderer.heading = ({ tokens, depth }) => {
  const text = plainText(tokens).trim();
  const slug = slugify(text);
  const html = marked.Parser.parseInline(tokens);
  return `<h${depth} id="${slug}">${html}</h${depth}>`;
};

renderer.link = ({ href = '', title, tokens }) => {
  const text = escapeHtml(plainText(tokens).trim());
  const safeHref = rewriteHref(href, page);
  const titleAttr = title ? ` title="${escapeHtml(title)}"` : '';
  return `<a href="${escapeHtml(safeHref)}"${titleAttr}>${text}</a>`;
};

renderer.image = ({ href = '', text = '', title }) => {
  const src = rewriteAssetHref(href, page);
  const alt = escapeHtml(text || '');
  const titleAttr = title ? ` title="${escapeHtml(title)}"` : '';
  return `<img src="${escapeHtml(src)}" alt="${alt}"${titleAttr} loading="lazy" />`;
};

marked.setOptions({ gfm: true, breaks: false, renderer });
const html = marked.parse(page.raw);

function plainText(tokens = []) {
  return tokens.map((token) => token.text || token.raw || plainText(token.tokens || [])).join('');
}

function slugify(value) {
  return value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
}

function rewriteHref(href, page) {
  if (!href || /^(?:[a-z]+:|\/\/|#)/i.test(href)) return href;
  const { path: hrefPath, suffix } = splitHref(href);
  if (isCurrentPagePath(hrefPath)) return `${currentPageHref(page)}${suffix}`;
  if (hrefPath.startsWith('/')) return `${withBase(base, hrefPath.slice(1))}${suffix}`;
  const resolved = resolvePath(page.relativePath, hrefPath);
  if (page.kind === 'source') {
    if (resolved.toLowerCase().endsWith('.md')) return `${sourceDocHref(page.sourceId, resolved)}${suffix}`;
    if (!pathHasExtension(resolved)) return `${withBase(base, `docs/sources/${page.sourceId}/${resolved}/`)}${suffix}`;
    return rewriteAssetHref(href, page);
  }
  if (page.kind === 'portal' && (resolved.toLowerCase().endsWith('.md') || !pathHasExtension(resolved))) {
    return `${portalDocHref(resolved)}${suffix}`;
  }
  return href;
}

function sourceDocHref(sourceId, resolved) {
  const withoutExt = resolved.replace(/\.md$/i, '');
  const cleaned = withoutExt.replace(/\/README$/i, '').replace(/^README$/i, '');
  return withBase(base, `docs/sources/${sourceId}${cleaned ? `/${cleaned}` : ''}/`);
}

function portalDocHref(resolved) {
  const slug = resolved.replace(/\.md$/i, '').replace(/\/$/, '');
  return withBase(base, `docs/${slug && slug !== 'overview' ? `${slug}/` : ''}`);
}

function rewriteAssetHref(href, page) {
  if (!href || /^(?:[a-z]+:|\/\/|#)/i.test(href)) return href;
  const { path: hrefPath, suffix } = splitHref(href);
  if (isCurrentPagePath(hrefPath)) return `${currentPageHref(page)}${suffix}`;
  if (hrefPath.startsWith('/')) return `${withBase(base, hrefPath.slice(1))}${suffix}`;
  if (page.kind !== 'source') return href;
  return `${withBase(base, `_sources/${page.sourceId}/${resolvePath(page.relativePath, hrefPath)}`)}${suffix}`;
}

function currentPageHref(page) {
  return withBase(base, page.href.replace(/^\/+/, ''));
}

function splitHref(value) {
  const index = value.search(/[?#]/);
  if (index === -1) return { path: value, suffix: '' };
  return { path: value.slice(0, index), suffix: value.slice(index) };
}

function isCurrentPagePath(value) {
  return !value || value === '.' || value === './';
}

function resolvePath(fromFile, target) {
  const fromParts = fromFile.split('/').slice(0, -1);
  const parts = `${fromParts.join('/')}/${target}`.split('/');
  const out = [];
  for (const part of parts) {
    if (!part || part === '.') continue;
    if (part === '..') out.pop();
    else out.push(part);
  }
  return out.join('/');
}

function pathHasExtension(value) {
  return /\.[a-z0-9]+$/i.test(value);
}

function escapeHtml(value) {
  return value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}
---
<div class="prose" set:html={html} />
