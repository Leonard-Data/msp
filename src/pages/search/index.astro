---
// @ts-nocheck
import docsData from '../../generated/docs-data.json';
import searchIndex from '../../generated/search-index.json';
import BaseLayout from '../../layouts/BaseLayout.astro';

const repoUrl = `https://github.com/${process.env.GITHUB_REPOSITORY || 'company/MSP-Portal'}`;
const base = import.meta.env.BASE_URL;
const serialized = JSON.stringify(searchIndex);
const categories = docsData.categories.map((category) => category.name);
---
<BaseLayout title="Search · MSP Docs" description="Search across every synced documentation repository" repoUrl={repoUrl}>
  <main class="content search-page">
    <section class="search-hero">
      <div>
        <p class="library-kicker">Documentation Library</p>
        <h1>Search across every synced repository.</h1>
        <p class="lead">Find source-owned documentation without leaving the portal. The index stays static, the reading experience does not.</p>
      </div>
      <div class="search-hero__meta">
        {categories.map((category) => <span class="pill">{category}</span>)}
      </div>
    </section>

    <section class="search-panel" data-search-root data-search-index={serialized}>
      <label class="meta-label" for="search-box">Search the library</label>
      <input id="search-box" type="search" placeholder="Search for topics, snippets, workflows, or errors" />
      <div class="search-hint">Results pull from titles, descriptions, headings, and page content.</div>
      <div class="search-results" data-search-results></div>
    </section>
  </main>

  <script is:inline>
    const root = document.querySelector('[data-search-root]');
    const input = root?.querySelector('input');
    const results = root?.querySelector('[data-search-results]');
    const index = JSON.parse(root?.dataset.searchIndex || '[]');
    const base = document.documentElement.dataset.base || '/';
    const params = new URLSearchParams(window.location.search);

    function rank(query, item) {
      const q = query.toLowerCase();
      const title = (item.title || '').toLowerCase();
      const headings = (item.headings || '').toLowerCase();
      const category = (item.category || '').toLowerCase();
      const sourceName = (item.sourceName || '').toLowerCase();
      const content = (item.content || '').toLowerCase();
      const haystack = `${title} ${item.description || ''} ${headings} ${content}`.toLowerCase();
      if (!q) return 1;
      if (!haystack.includes(q)) return 0;
      let score = 1;
      if (title.includes(q)) score += 8;
      if (headings.includes(q)) score += 4;
      if (sourceName.includes(q) || category.includes(q)) score += 2;
      if ((item.description || '').toLowerCase().includes(q)) score += 2;
      return score;
    }

    function snippetFor(query, item) {
      if (!query) return item.description || '';
      const content = item.content || item.description || '';
      const lower = content.toLowerCase();
      const index = lower.indexOf(query.toLowerCase());
      if (index === -1) return item.description || '';
      const start = Math.max(0, index - 70);
      const end = Math.min(content.length, index + query.length + 90);
      const prefix = start > 0 ? '…' : '';
      const suffix = end < content.length ? '…' : '';
      return `${prefix}${content.slice(start, end).trim()}${suffix}`;
    }

    function escapeHtml(value) {
      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function renderDefault() {
      const items = index.slice(0, 8);
      render(items, '');
    }

    function render(items, query) {
      results.innerHTML = items.length ? items.map((item) => `
        <a class="search-result-card" href="${base}${item.href.replace(/^\//, '')}">
          <div class="search-result-card__meta">
            <span class="pill">${escapeHtml(item.category || 'General')}</span>
            <span>${escapeHtml(item.sourceName || 'MSP')}</span>
          </div>
          <strong>${escapeHtml(item.title)}</strong>
          <p>${escapeHtml(snippetFor(query, item))}</p>
        </a>
      `).join('') : '<p class="muted">No results.</p>';
    }

    function refresh() {
      const query = input?.value.trim() || '';
      if (!query) {
        renderDefault();
        return;
      }
      const matches = index
        .map((item) => ({ item, score: rank(query, item) }))
        .filter((entry) => entry.score > 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 25)
        .map((entry) => entry.item);
      render(matches, query);
    }

    if (input) {
      input.value = params.get('q') || '';
      input.addEventListener('input', refresh);
      refresh();
    }
  </script>
</BaseLayout>
