---
// @ts-nocheck
import fs from 'node:fs/promises';
import docsData from '../../generated/docs-data.json';
import DocsLayout from '../../layouts/DocsLayout.astro';
import MarkdownContent from '../../components/MarkdownContent.astro';
import { withBase } from '../../lib/base-path';

const page = docsData.pages.find((entry) => entry.href === '/docs/');
page.raw = await fs.readFile(`${process.cwd()}/${page.file}`, 'utf8');
const repoUrl = `https://github.com/${process.env.GITHUB_REPOSITORY || 'company/MSP-Portal'}`;
const base = import.meta.env.BASE_URL;
---
<DocsLayout title={`${page.title} · MSP Docs`} description={page.description} sidebar={docsData.sidebar} toc={page.headings} repoUrl={repoUrl} currentPath="/docs/">
  <header class="doc-header">
    <div class="doc-meta">
      <span class="pill">Portal overview</span>
      <span>Documentation Library</span>
    </div>
    <h1>{page.title}</h1>
    <p class="lead">{page.description}</p>
  </header>

  <section class="inline-panel inline-panel--search">
    <div>
      <h2>Jump straight into the library</h2>
      <p class="muted">Search when you know what you need, or open a source shelf when you want to browse the catalog.</p>
    </div>
    <div class="inline-panel__actions">
      <a class="button button--primary" href={withBase(base, 'search/')}>Open search</a>
      <a class="button button--ghost" href={withBase(base, 'docs/how-it-works/')}>How it works</a>
    </div>
  </section>

  <MarkdownContent page={page} />
</DocsLayout>
