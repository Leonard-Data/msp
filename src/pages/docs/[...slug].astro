---
// @ts-nocheck
import fs from 'node:fs/promises';
import docsData from '../../generated/docs-data.json';
import DocsLayout from '../../layouts/DocsLayout.astro';
import MarkdownContent from '../../components/MarkdownContent.astro';

export function getStaticPaths() {
  return docsData.pages
    .filter((page) => page.href !== '/docs/')
    .flatMap((page) => {
      const canonicalSlug = page.href.replace(/^\/docs\//, '').replace(/\/$/, '');
      const slugs = [canonicalSlug];
      if (page.kind === 'source' && /(^|\/)README\.md$/i.test(page.relativePath || '')) {
        slugs.push(`${canonicalSlug}/README`);
      }
      return slugs.map((slug) => ({ params: { slug }, props: { page } }));
    });
}

const { page } = Astro.props;
page.raw = await fs.readFile(`${process.cwd()}/${page.file}`, 'utf8');
const repoUrl = `https://github.com/${process.env.GITHUB_REPOSITORY || 'company/MSP-Portal'}`;
const editUrl = githubEditUrl(page.kind === 'source' ? page.repoUrl : repoUrl, page.defaultBranch || process.env.GITHUB_REF_NAME || 'main', page.kind === 'source' ? `${page.docsPath || 'docs'}/${page.relativePath}` : page.file);
const toc = page.headings.filter((item) => item.depth <= 3);

function githubEditUrl(repository, branch, file) {
  const path = file.split('/').map(encodeURIComponent).join('/');
  return `${repository.replace(/\/$/, '')}/edit/${encodeURIComponent(branch)}/${path}`;
}
---
<DocsLayout title={`${page.title} · MSP Docs`} description={page.description} sidebar={docsData.sidebar} toc={toc} repoUrl={repoUrl} currentPath={page.href}>
  <header class="doc-header">
    <div class="doc-meta">
      <span class="pill">{page.category}</span>
      <span>{page.kind === 'source' ? page.sourceName : 'MSP Portal'}</span>
      {page.kind === 'source' && <span>{page.repo}</span>}
    </div>
    <h1>{page.title}</h1>
    <p class="lead">{page.description}</p>
    <div class="doc-actions">
      {page.kind === 'source' ? <span class="meta-label">Source repository</span> : <span class="meta-label">Portal page</span>}
      {page.kind === 'source' ? <a class="button button--ghost button--sm" href={page.repoUrl} target="_blank" rel="noreferrer">Open source repository</a> : null}
      <a class="button button--ghost button--sm" href={editUrl} target="_blank" rel="noreferrer">Edit on GitHub</a>
    </div>
  </header>
  <MarkdownContent page={page} />
</DocsLayout>
